<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="security_turtlebot">

  <xacro:arg name="model" default="standard"/>
    <xacro:include filename="$(find turtlebot4_description)/urdf/standard/turtlebot4.urdf.xacro"/>

  <link name="camera_neck_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.08"/></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="camera_pan_joint" type="continuous">
    <parent link="base_link"/>
    <child link="camera_neck_link"/>
    <origin xyz="0.05 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="security_camera_link">
    <visual>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <material name="red_sentinel"><color rgba="0.8 0.0 0.0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_fixed_joint" type="fixed">
    <parent link="camera_neck_link"/>
    <child link="security_camera_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

</robot>