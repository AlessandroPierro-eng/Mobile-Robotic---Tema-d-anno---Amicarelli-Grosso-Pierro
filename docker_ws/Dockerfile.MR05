FROM ros:jazzy

# System updates, basic tools, and Python build dependencies
RUN apt update -y && apt install -y wget git nano curl python3-dev build-essential libgl1 libglib2.0-0 python3-numpy

# ROS 2 graphical debugging and visualization tools
RUN apt update -y && apt install -y ros-jazzy-rqt-graph ros-jazzy-rqt-tf-tree ros-jazzy-rviz2

# Simulation environment and robot description packages
RUN apt-get update -y && apt-get install -y ros-jazzy-ros-gz ros-jazzy-xacro ros-jazzy-turtlebot4-description ros-jazzy-irobot-create-* && rm -rf /var/lib/apt/lists/*

# SLAM and teleoperation packages
RUN apt update -y && apt install -y ros-jazzy-slam-toolbox ros-jazzy-teleop-twist-keyboard

# Navigation2 stack
RUN apt update -y && apt install -y ros-jazzy-navigation2 ros-jazzy-nav2-bringup

# Localization and sensor processing packages
RUN apt update -y && apt install -y ros-jazzy-robot-localization ros-jazzy-apriltag-ros

# Computer vision dependencies
RUN apt update -y && apt install -y ros-jazzy-vision-opencv

# Install 'uv' package manager for optimized Python environments
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Create a virtual environment with system site-packages access for ROS 2 compatibility
RUN uv venv --system-site-packages /opt/venv

# Install YOLOv8 and compatible NumPy version within the virtual environment
RUN . /opt/venv/bin/activate && uv pip install "numpy<2.0.0" ultralytics